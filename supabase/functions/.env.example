# Hosted Supabase injects SUPABASE_URL and SUPABASE_SECRET_KEYS automatically.
# For local development, add the matching values from `supabase status` if needed.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=results@example.com
BREVO_SENDER_NAME=부사관 진로적성검사
INTERNAL_WEBHOOK_SECRET=replace-with-a-long-random-value
ADMIN_DASHBOARD_PASSWORD=replace-with-a-long-unique-admin-password
